{
  "name": "reino-de-valdemar",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Juego medieval 3D con ganado, fertilidad de campos, logística y clima dinámico",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "check": "node --check src/main.js && node --check src/world.js && node --check src/simulation.js && node --check vite.config.js && node --check electron.cjs && node --test tests/simulation.test.js",
    "desktop": "electron .",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.1.12",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "main": "electron.cjs",
  "build": {
    "appId": "com.valdemar.kingdom",
    "productName": "Reino de Valdemar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": null
    }
  }
}
